#include <stdio.h>

int main()

{

  float num1, num2;

  char operador;



  printf("=== Calculadora ===");

  printf("\nDigite um número: ");

  scanf(" %f", &num1);

  printf("Digite outro número: ");

  scanf(" %f", &num2);

  printf("Qual será a operação [+|-|x|/]: ");

  scanf(" %c", &operador);

  switch(operador){
    case'+':
    printf("%.0f + %.0f=%.2f", num1, num2,(num1+num2));
    break;
    case'-':
    printf("%.0f - %.0f+ %.2f", num1, num2,(num1-num2));
    break;
    case 'x': 
    printf("%.0F x %.0F= %.2F", num1, num2,(num1 * num2));
    break;
    case '/':
    if (num2==0.00){
    printf("Operação Invalida!");
    }
    else{
    printf("%.0f / %.0f = %.2f",num1,num2,(num1/num2));
    break;
    default:
    printf("Operador invalido!");}
  }
}
